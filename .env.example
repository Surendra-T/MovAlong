# MovAlong Environment Configuration

# MongoDB
MONGODB_URI=mongodb://localhost:27017/movalong
MONGODB_DB=movalong

# Ollama Gemma LLM (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma2:9b

# Whisper
WHISPER_MODEL=base

# JWT Security
JWT_SECRET=change-this-to-a-secure-random-secret
JWT_EXPIRE_DAYS=7

# Server & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000